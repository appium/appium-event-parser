{
  "name": "appium-event-parser",
  "version": "1.2.0",
  "description": "Event Timing Parser",
  "keywords": [
    "appium",
    "event timings",
    "profiling"
  ],
  "bugs": {
    "url": "https://github.com/appium/appium-event-parser/issues"
  },
  "license": "Apache-2.0",
  "author": "Appium Contributors",
  "repository": {
    "type": "git",
    "url": "https://github.com/appium/appium-event-parser.git"
  },
  "bin": {
    "appium-event-parser": "./build/lib/cli.js"
  },
  "directories": {
    "lib": "./lib"
  },
  "files": [
    "lib",
    "build/lib",
    "CHANGELOG.md"
  ],
  "type": "module",
  "scripts": {
    "build": "tsc -b",
    "clean": "npm run build -- --clean",
    "rebuild": "npm run clean && npm run build",
    "dev": "npm run build -- --watch",
    "lint": "oxlint -c oxlint.config.mjs .",
    "lint:fix": "oxlint -c oxlint.config.mjs --fix .",
    "format": "oxfmt -c oxfmt.config.mjs .",
    "format:check": "oxfmt -c oxfmt.config.mjs --check .",
    "prepare": "npm run build",
    "test": "node --enable-source-maps --test --test-timeout=60000 \"./build/test/**/*.spec.js\""
  },
  "dependencies": {
    "asyncbox": "^6.6.0",
    "commander": "^15.0.0"
  },
  "devDependencies": {
    "@appium/oxc-config": "^2.0.0-beta.2",
    "@appium/semantic-release-config": "^2.0.0-beta.1",
    "@appium/tsconfig": "^2.0.0-beta.1",
    "@types/node": "^26.0.0"
  },
  "engines": {
    "node": "^22.22.2 || ^24.15.0 || >=26.0.0",
    "npm": ">=10"
  }
}
